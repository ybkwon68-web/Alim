# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Configuration (for AI Summarization)
GEMINI_API_KEY=your_gemini_api_key_here

# DART Open API Configuration (for Korean Stock Disclosures)
DART_API_KEY=your_dart_api_key_here

# SMTP Configuration (for sending email reports)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SENDER_EMAIL=your_email@gmail.com

# Database Path (Default to SQLite database in project root)
DATABASE_PATH=alim_bot.db
